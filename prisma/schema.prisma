generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  STUDENT
}

enum LearningContext {
  DAILY_LIFE
  ENVIRONMENT
  TECHNOLOGY
}

enum CaseValidationStatus {
  DRAFT
  IN_REVIEW
  VALIDATED
  REJECTED
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentType {
  PRE_TEST
  POST_TEST
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  PENDING_GRADING
  GRADED
}

// ==========================================
// USER
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Case validation
  validatedCases ValidatedCase[] @relation("CaseValidator")

  // Student assessment attempts
  assessmentAttempts AssessmentAttempt[]
}

// ==========================================
// VALIDATED CASE
// ==========================================

model ValidatedCase {
  id                     String          @id @default(uuid()) @db.Uuid
  title                  String
  context                LearningContext
  topic                  String
  stimulus               String          @db.Text
  scientificData         Json?
  targetConcept          String          @db.Text
  possibleMisconceptions Json?
  expertAnswer           String          @db.Text

  // Case versioning
  caseGroupId String @db.Uuid
  version     Int    @default(1)

  // Validation workflow
  validationStatus CaseValidationStatus @default(DRAFT)

  validatorId     String?   @db.Uuid
  validator       User?     @relation("CaseValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  rejectionReason String?   @db.Text

  // Learning modules referencing this case version
  learningModules LearningModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseGroupId, version])
  @@index([caseGroupId])
  @@index([context])
  @@index([validationStatus])
  @@index([validatorId])
}

// ==========================================
// LEARNING MODULE
// ==========================================

model LearningModule {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?      @db.Text
  topic       String
  status      ModuleStatus @default(DRAFT)

  // Learning module specifications
  version            Int    @default(1)
  gradeLevel         String @default("SMA")
  learningObjectives String @default("") @db.Text
  targetConcepts     String @default("") @db.Text

  // References a specific case version
  caseId String        @db.Uuid
  case   ValidatedCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  // Pre-test and post-test
  assessments Assessment[]

  // Shared questions used by both tests
  assessmentQuestions AssessmentQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
}

// ==========================================
// ASSESSMENT
// ==========================================

model Assessment {
  id     String           @id @default(uuid()) @db.Uuid
  title  String
  type   AssessmentType
  status AssessmentStatus @default(DRAFT)

  // Parent learning module
  moduleId String         @db.Uuid
  module   LearningModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  // Student attempts
  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, type])
  @@index([moduleId])
  @@index([status])
  @@index([type])
}

// ==========================================
// SHARED ASSESSMENT QUESTION
// ==========================================

model AssessmentQuestion {
  id String @id @default(uuid()) @db.Uuid

  // Shared question belongs to a learning module
  moduleId String         @db.Uuid
  module   LearningModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  type         QuestionType
  questionText String       @db.Text
  order        Int

  // MCQ question fields
  // Example:
  // [
  //   { "key": "A", "text": "Option A" },
  //   { "key": "B", "text": "Option B" }
  // ]
  options       Json?
  correctAnswer String?

  // Essay grading fields
  rubric   String? @db.Text
  maxScore Float   @default(1)

  // Critical-thinking indicator
  // Example: INTERPRETATION, ANALYSIS, EVALUATION
  indicator String?

  // Student answers from both pre-test and post-test
  answers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, order])
  @@index([moduleId])
}

// ==========================================
// ASSESSMENT ATTEMPT
// ==========================================

model AssessmentAttempt {
  id           String             @id @default(uuid()) @db.Uuid
  assessmentId String             @db.Uuid
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  studentId    String             @db.Uuid
  student      User               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status       AttemptStatus      @default(IN_PROGRESS)
  startedAt    DateTime           @default(now())
  submittedAt  DateTime?
  gradedAt     DateTime?
  answers      AssessmentAnswer[]

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
}

// ==========================================
// ASSESSMENT ANSWER
// ==========================================

model AssessmentAnswer {
  id String @id @default(uuid()) @db.Uuid

  // Parent assessment attempt
  attemptId String            @db.Uuid
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  // Shared question
  questionId String             @db.Uuid
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // Student's answer
  answer String @db.Text

  // MCQ: automatically graded
  // ESSAY: manually graded
  score    Float?
  feedback String?   @db.Text
  gradedAt DateTime?

  // One answer per question per attempt
  @@unique([attemptId, questionId])
  @@index([questionId])
}
