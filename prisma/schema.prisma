generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  STUDENT
}

enum LearningContext {
  DAILY_LIFE
  ENVIRONMENT
  TECHNOLOGY
}

enum CaseValidationStatus {
  DRAFT
  IN_REVIEW
  VALIDATED
  REJECTED
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentType {
  PRE_TEST
  POST_TEST
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  PENDING_GRADING
  GRADED
}

// ==========================================
// MODULE ASSIGNMENT ENUMS
// ==========================================

enum ModuleAssignmentStatus {
  ACTIVE
  COMPLETED
}

enum ModuleProgressStage {
  PRE_TEST
  LEARNING
  POST_TEST
  COMPLETED
}

// ==========================================
// LEARNING SESSION ENUMS
// ==========================================

enum LearningSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum LearningPhaseStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

// ==========================================
// USER
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Case validation
  validatedCases ValidatedCase[] @relation("CaseValidator")

  // Student assessment attempts
  assessmentAttempts AssessmentAttempt[]

  // Student module assignments
  moduleAssignments StudentModuleAssignment[]
}

// ==========================================
// VALIDATED CASE
// ==========================================

model ValidatedCase {
  id                     String          @id @default(uuid()) @db.Uuid
  title                  String
  context                LearningContext
  topic                  String
  stimulus               String          @db.Text
  scientificData         Json?
  targetConcept          String          @db.Text
  possibleMisconceptions Json?
  expertAnswer           String          @db.Text

  // Case versioning
  caseGroupId String @db.Uuid
  version     Int    @default(1)

  // Validation workflow
  validationStatus CaseValidationStatus @default(DRAFT)

  validatorId String? @db.Uuid
  validator   User?   @relation("CaseValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  validatedAt     DateTime?
  rejectionReason String?   @db.Text

  // Learning modules referencing this case version
  learningModules LearningModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseGroupId, version])
  @@index([caseGroupId])
  @@index([context])
  @@index([validationStatus])
  @@index([validatorId])
}

// ==========================================
// LEARNING MODULE
// ==========================================

model LearningModule {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?      @db.Text
  topic       String
  status      ModuleStatus @default(DRAFT)

  // Learning module specifications
  version            Int    @default(1)
  gradeLevel         String @default("SMA")
  learningObjectives String @default("") @db.Text
  targetConcepts     String @default("") @db.Text

  // References a specific case version
  caseId String        @db.Uuid
  case   ValidatedCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  // Pre-test and post-test
  assessments Assessment[]

  // Shared questions used by both tests
  assessmentQuestions AssessmentQuestion[]

  // Student module assignments
  studentAssignments StudentModuleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status])
}

// ==========================================
// ASSESSMENT
// ==========================================

model Assessment {
  id     String           @id @default(uuid()) @db.Uuid
  title  String
  type   AssessmentType
  status AssessmentStatus @default(DRAFT)

  // Parent learning module
  moduleId String         @db.Uuid
  module   LearningModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  // Student attempts
  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, type])
  @@index([moduleId])
  @@index([status])
  @@index([type])
}

// ==========================================
// SHARED ASSESSMENT QUESTION
// ==========================================

model AssessmentQuestion {
  id String @id @default(uuid()) @db.Uuid

  // Shared question belongs to a learning module
  moduleId String         @db.Uuid
  module   LearningModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  type         QuestionType
  questionText String       @db.Text
  order        Int

  // MCQ question fields
  // Example:
  // [
  //   { "key": "A", "text": "Option A" },
  //   { "key": "B", "text": "Option B" }
  // ]
  options       Json?
  correctAnswer String?

  // Essay grading fields
  rubric   String? @db.Text
  maxScore Float   @default(1)

  // Critical-thinking indicator
  // Example: INTERPRETATION, ANALYSIS, EVALUATION
  indicator String?

  // Student answers from both pre-test and post-test
  answers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, order])
  @@index([moduleId])
}

// ==========================================
// ASSESSMENT ATTEMPT
// ==========================================

model AssessmentAttempt {
  id           String     @id @default(uuid()) @db.Uuid
  assessmentId String     @db.Uuid
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  studentId String @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  answers AssessmentAnswer[]

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
}

// ==========================================
// ASSESSMENT ANSWER
// ==========================================

model AssessmentAnswer {
  id String @id @default(uuid()) @db.Uuid

  // Parent assessment attempt
  attemptId String            @db.Uuid
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  // Shared question
  questionId String             @db.Uuid
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // Student's answer
  answer String @db.Text

  // MCQ: automatically graded
  // ESSAY: manually graded
  score    Float?
  feedback String?   @db.Text
  gradedAt DateTime?

  // One answer per question per attempt
  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ==========================================
// STUDENT MODULE ASSIGNMENT
// ==========================================

model StudentModuleAssignment {
  id String @id @default(uuid()) @db.Uuid

  // Assigned student
  studentId String @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Assigned learning module
  moduleId String         @db.Uuid
  module   LearningModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  // Context selected by the student
  context LearningContext

  // Assignment lifecycle
  status ModuleAssignmentStatus @default(ACTIVE)
  stage  ModuleProgressStage    @default(PRE_TEST)

  // Learning session (created after pre-test)
  learningSession LearningSession?

  // Timestamps
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent assigning the same module twice
  // to the same student
  @@unique([studentId, moduleId])
  // Query optimization
  @@index([studentId, status])
  @@index([moduleId])
  @@index([context])
}

// ==========================================
// LEARNING SESSION
// ==========================================

model LearningSession {
  id String @id @default(uuid()) @db.Uuid

  // One session per module assignment
  assignmentId String                  @unique @db.Uuid
  assignment   StudentModuleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  // Learning session lifecycle
  status       LearningSessionStatus @default(IN_PROGRESS)
  currentPhase Int                   @default(1)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Five learning phases
  phases LearningPhaseProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ==========================================
// LEARNING PHASE PROGRESS
// ==========================================

model LearningPhaseProgress {
  id String @id @default(uuid()) @db.Uuid

  // Parent learning session
  sessionId String          @db.Uuid
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  // Phase number: 1, 2, 3, 4, or 5
  phaseNumber Int

  // Phase lifecycle
  status LearningPhaseStatus @default(LOCKED)

  startedAt   DateTime?
  completedAt DateTime?

  // Student responses and AI feedback
  responses LearningPhaseResponse[]

  // Structured phase submission
  submission LearningPhaseSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One progress record per phase per session
  @@unique([sessionId, phaseNumber])
  @@index([status])
}

// ==========================================
// LEARNING PHASE RESPONSE
// ==========================================

model LearningPhaseResponse {
  id String @id @default(uuid()) @db.Uuid

  // Parent learning phase
  phaseProgressId String                @db.Uuid
  phaseProgress   LearningPhaseProgress @relation(fields: [phaseProgressId], references: [id], onDelete: Restrict)

  // Student's response
  answer String @db.Text

  // Optional AI-generated content and feedback
  question   String? @db.Text
  aiFeedback String? @db.Text
  aiMetadata Json?

  // Response history
  createdAt DateTime @default(now())

  @@index([phaseProgressId, createdAt])
}

// ==========================================
// LEARNING PHASE SUBMISSION
// ==========================================

model LearningPhaseSubmission {
  id String @id @default(uuid()) @db.Uuid

  // One structured submission per phase
  phaseProgressId String                @unique @db.Uuid
  phaseProgress   LearningPhaseProgress @relation(fields: [phaseProgressId], references: [id], onDelete: Restrict)

  // Phase-specific structured answers
  // Phase 1: prediction, reasoning, confidence
  // Phase 4: claim, evidence, reasoning,
  //          alternativeArgument, revision
  content Json

  // Submission lifecycle
  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// AI PROMPT CONFIGURATION
// ==========================================

model AIPromptConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique
  version             Int      @default(1)
  isActive            Boolean  @default(true)

  // Customizable prompt components
  role                String   @db.Text
  objective           String   @db.Text
  caseCharacteristics String   @db.Text
  guidanceStrategy    Json

  // Model parameters
  model               String   @default("gpt-4o")
  temperature         Float    @default(0.3)
  maxTokens           Int      @default(1000)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive])
}

